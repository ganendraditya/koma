# Koma Development Environment Variables (Optional)
# Note: In production Koma uses BYOK (Bring Your Own Key) configured via the Chrome Extension options.
# These environment variables can be used for local testing and CLI development scripts.

# Google Gemini API Key (multimodal translation)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Default Target Language: 'id' (Bahasa Indonesia) or 'en' (English)
VITE_DEFAULT_TARGET_LANG=id
